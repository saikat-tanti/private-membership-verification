{
  "name": "private-membership-verification",
  "version": "1.0.0",
  "type": "module",
  "description": "Private Membership Verification dApp on Midnight Network",
  "author": "SAIKAT TANTI",
  "license": "MIT",
  "private": true,
  "workspaces": {
    "packages": [
      "membership-cli",
      "membership-ui",
      "api",
      "contract"
    ]
  },
  "scripts": {
    "compile": "npm run compact --workspace=@midnight-ntwrk/membership-contract",
    "build": "npm run typecheck --workspace=@midnight-ntwrk/membership-cli && npm run build --workspace=@midnight-ntwrk/membership-ui",
    "setup": "npx tsx membership-cli/src/setup.ts",
    "deploy": "npx tsx membership-cli/src/deploy.ts",
    "cli": "npx tsx membership-cli/src/cli.ts",
    "check-balance": "npx tsx membership-cli/src/check-balance.ts",
    "network": "npx tsx membership-cli/src/network.ts",
    "proof-server:start": "docker compose up -d",
    "proof-server:stop": "docker compose down",
    "clean": "rm -rf contract/src/managed",
    "test": "node --import tsx --test membership-cli/src/test/*.test.ts",
    "demo:verify": "npx tsx scripts/demo-verify.ts",
    "dev": "npm run dev --workspace=@midnight-ntwrk/membership-ui",
    "test:e2e": "tsx scripts/e2e-check.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "rxjs": "^7.8.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "midnight",
    "blockchain",
    "zero-knowledge",
    "privacy",
    "allowlist",
    "membership"
  ]
}
