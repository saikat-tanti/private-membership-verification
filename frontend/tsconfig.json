{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@contract/*": ["../contracts/managed/private-membership-verification/*"]
    },
    "baseUrl": "."
  },
  "include": ["next-env.d.ts", "app/**/*.ts", "app/**/*.tsx", "lib/lace.ts", "lib/config.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "lib/contract.ts"]
}
